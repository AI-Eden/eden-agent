{
  "name": "eden-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "code:check": "biome check .",
    "code:fix": "biome check --write .",
    "hooks:install": "node scripts/configure-hooks.mjs",
    "markdown:check": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "markdown:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "test:r2-native-archive": "node scripts/r2-native-tools-archive.mjs apps/eden/dist",
    "test:r2-budgets": "node --test scripts/r2-contract-budgets.test.mjs",
    "test:r2-process": "node --test packages/coding-runtime/test/native-process.test.ts packages/coding-runtime/test/workspace-trust-process.test.ts packages/coding-runtime/test/workspace-trust-matrix-process.test.ts apps/eden/test/headless-process.test.ts",
    "test:r2-provider-fixtures": "pnpm --filter @eden/providers test && node --test packages/coding-runtime/test/provider-agent-client.test.ts packages/coding-runtime/test/provider-model-loop.test.ts packages/coding-runtime/test/provider-readiness.test.ts",
    "test:r2-secret-canaries": "node --test packages/providers/test/openai-compatible.test.ts packages/coding-runtime/test/provider-profile-store.test.ts packages/coding-runtime/test/provider-readiness.test.ts apps/eden/test/run-history.test.ts",
    "test:r2-tui-pty": "node scripts/r2-tui-pty.mjs apps/eden/dist/eden docs/benchmark-results/2026-07-20-r2-tui-linux-x64.json",
    "test": "node --test scripts/*.test.mjs && pnpm --workspace-concurrency=1 -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "24.13.3",
    "markdownlint-cli2": "0.23.0",
    "typescript": "7.0.2"
  }
}
