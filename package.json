{
  "name": "eden-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "hooks:install": "node scripts/configure-hooks.mjs",
    "markdown:check": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "markdown:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "markdownlint-cli2": "0.23.0",
    "typescript": "5.9.3"
  }
}
