{
  "name": "@eden/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "eden": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "package:bun": "node scripts/package-bun.mjs",
    "start": "bun src/index.ts",
    "test": "bun test ./test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eden/coding-runtime": "workspace:*",
    "@eden/contracts": "workspace:*",
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.3",
    "@opentui/react": "0.4.3",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "bun": "1.3.14"
  }
}
