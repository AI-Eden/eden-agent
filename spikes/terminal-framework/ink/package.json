{
  "name": "@eden/terminal-spike-ink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./src/app.tsx",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false",
    "package:bun": "pnpm --filter @eden/terminal-spike-harness package -- ink-bun",
    "package:node": "pnpm --filter @eden/terminal-spike-harness package -- ink-node",
    "start:bun": "bun src/cli.tsx",
    "start:node": "node --import tsx src/cli.tsx",
    "test": "pnpm test:node && pnpm test:bun",
    "test:bun": "bun test/verify.tsx && bun test/editor.tsx",
    "test:node": "node --import tsx test/verify.tsx && node --import tsx test/editor.tsx",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@eden/terminal-spike-fixture": "workspace:*",
    "ink": "7.1.0",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "bun": "1.3.14",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.1"
  }
}
